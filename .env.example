PORT=3000
DB_SERVER=localhost
DB_PORT=1433
# สำหรับ SQL Server named instance ให้ใช้ DB_INSTANCE=SQLEXPRESS และเว้น DB_PORT ว่าง
# DB_INSTANCE=
DB_NAME=KitchenStock
DB_USER=sa
DB_PASSWORD=ChangeMe
DB_ENCRYPT=true
DB_TRUST_CERT=true
# สุ่มข้อความยาวอย่างน้อย 32 ตัวอักษร
JWT_SECRET=
# บัญชี admin ที่ระบบสร้าง/ตั้งรหัสผ่านใหม่ให้ทุกครั้งที่เริ่มแอป
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ตั้งเป็น true เมื่อใช้งานผ่าน HTTPS
COOKIE_SECURE=false

# ---- แจ้งเตือน LINE (Messaging API) ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ได้จาก webhook ครั้งแรก (ดู README) ขึ้นต้นด้วยตัว C
LINE_GROUP_ID=
# รวมรายการของเชฟคนเดียวกันเป็นข้อความเดียว (วินาที) และเพดานข้อความต่อชั่วโมง
LINE_BATCH_SECONDS=30
LINE_MAX_PER_HOUR=30
